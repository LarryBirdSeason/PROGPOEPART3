<UserControl x:Class="SmartX.Client.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0B1220">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#111C30"/>
            <Setter Property="BorderBrush" Value="#1E2B44"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E3A5F"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7F1D1D" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding ApiOffline, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ConnectionMessage}" Foreground="White" TextWrapping="Wrap"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <WrapPanel>
                <TextBlock Text="{Binding MstText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding NetworkText}" Style="{StaticResource Muted}" Margin="0,0,24,0"/>
                <TextBlock Text="{Binding DownText}" Foreground="#F59E0B" FontSize="12"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" MinWidth="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Track a route" Style="{StaticResource Heading}"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6"
                                         ToolTip="MAC address or part of a device name, for example 24:6F:28:A1:00:09 or pump a">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding TrackCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="Track" Command="{Binding TrackCommand}"
                                        Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
                            </Grid>
                            <CheckBox Content="Highlight minimum spanning tree" IsChecked="{Binding ShowMst}"
                                      Foreground="#CBD5E1" Margin="0,2,0,10"/>

                            <TextBlock Text="{Binding RouteTitle}" Foreground="White" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RouteMessage}" Foreground="{Binding RouteBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,2,0,8"/>

                            <ItemsControl ItemsSource="{Binding RoutePath}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}"
                                                     VerticalAlignment="Top" Margin="0,5,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="White"/>
                                                <TextBlock Text="{Binding CostText}" Style="{StaticResource Muted}"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Hints}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#F59E0B" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Subnet reachability" Style="{StaticResource Heading}"/>
                            <ComboBox ItemsSource="{Binding GatewayOptions}" SelectedItem="{Binding SelectedGateway}"
                                      DisplayMemberPath="Name" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SubnetSummary}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TraversalText}" Style="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding SubnetNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Brush}"
                                                     VerticalAlignment="Top" Margin="0,5,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="White"/>
                                                <TextBlock Text="{Binding Hint}" Foreground="#F59E0B" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}"
                                                           FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding DepthText}" Style="{StaticResource Muted}"
                                                           FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Simulate a link failure" Style="{StaticResource Heading}"/>
                            <ComboBox ItemsSource="{Binding LinkOptions}" SelectedItem="{Binding SelectedLink}"
                                      DisplayMemberPath="Text" Margin="0,0,0,8"/>
                            <Button Content="Cut or restore link" Command="{Binding ToggleLinkCommand}"
                                    Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding LinkStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="260"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="2*" MinHeight="220"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Mesh network" Style="{StaticResource Heading}" Margin="0,0,16,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                <Ellipse Style="{StaticResource Dot}" Fill="#38BDF8"/>
                                <TextBlock Text="Server" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                <Ellipse Style="{StaticResource Dot}" Fill="#A78BFA"/>
                                <TextBlock Text="Gateway" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                <Ellipse Style="{StaticResource Dot}" Fill="#22C55E"/>
                                <TextBlock Text="Online" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                <Ellipse Style="{StaticResource Dot}" Fill="#EF4444"/>
                                <TextBlock Text="Down" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,8">
                                <Ellipse Style="{StaticResource Dot}" Fill="#F59E0B"/>
                                <TextBlock Text="Isolated / tracked route" Style="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock Text="Green lines: minimum spanning tree. Numbers: mW per hop. Click a node to track it."
                                       Style="{StaticResource Muted}" FontSize="11"/>
                        </WrapPanel>

                        <Viewbox Stretch="Uniform">
                            <Grid Width="{Binding MapWidth}" Height="{Binding MapHeight}" Background="#0B1220">
                                <ItemsControl ItemsSource="{Binding Edges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Canvas>
                                                <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}"
                                                      Stroke="{Binding Stroke}" StrokeThickness="{Binding Thickness}"
                                                      StrokeDashArray="{Binding Dash}"/>
                                                <TextBlock Canvas.Left="{Binding MidX}" Canvas.Top="{Binding MidY}"
                                                           Text="{Binding CostText}" Foreground="#94A3B8" FontSize="10"
                                                           Background="#0B1220"/>
                                            </Canvas>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Nodes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="100" Background="Transparent" Cursor="Hand"
                                                        ToolTip="{Binding ToolTip}">
                                                <StackPanel.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectNodeCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </StackPanel.InputBindings>
                                                <Ellipse Width="{Binding Diameter}" Height="{Binding Diameter}"
                                                         Fill="{Binding Fill}" Stroke="{Binding StrokeBrush}"
                                                         StrokeThickness="{Binding StrokeThickness}"
                                                         HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"
                                                           TextAlignment="Center" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding SubLabel}" Foreground="#94A3B8" FontSize="10"
                                                           TextAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Style="{StaticResource Heading}" Margin="0,0,0,6">
                                <Run Text="Historical log  ·  "/>
                                <Run Text="{Binding TrackedName, Mode=OneWay}"/>
                            </TextBlock>
                            <WrapPanel Margin="0,0,0,6">
                                <TextBlock Text="From" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBox Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" Width="130"
                                         Padding="4" Margin="0,0,10,0"/>
                                <TextBlock Text="To" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBox Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" Width="130"
                                         Padding="4" Margin="0,0,10,0"/>
                                <Button Content="Query" Command="{Binding QueryLogCommand}"
                                        Style="{StaticResource ActionButton}"/>
                                <Button Content="Last 30 min" Command="{Binding QuickRangeCommand}" CommandParameter="30"
                                        Style="{StaticResource ActionButton}"/>
                                <Button Content="Last 2 h" Command="{Binding QuickRangeCommand}" CommandParameter="120"
                                        Style="{StaticResource ActionButton}"/>
                                <Button Content="Last 4 h" Command="{Binding QuickRangeCommand}" CommandParameter="240"
                                        Style="{StaticResource ActionButton}"/>
                                <CheckBox Content="Newest first" IsChecked="{Binding NewestFirst}" Foreground="#CBD5E1"
                                          VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding LogSummary}" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TreeText}" Style="{StaticResource Muted}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,2,0,6"/>
                        </StackPanel>

                        <ListView ItemsSource="{Binding LogRows}" Background="Transparent" BorderThickness="0"
                                  Foreground="White">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="100" DisplayMemberBinding="{Binding DateText}"/>
                                    <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding TimeText}"/>
                                    <GridViewColumn Header="Value" Width="110" DisplayMemberBinding="{Binding ValueText}"/>
                                    <GridViewColumn Header="Level" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding LevelText}" Foreground="{Binding Brush}"
                                                           FontWeight="Bold" FontSize="11"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
